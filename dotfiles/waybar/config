{
    "layer": "bottom",
    "position": "top",
    "spacing": 0,
    "height": 0,
    "reload_style_on_change": true,
    "modules-left": [
        "custom/hostname",
	"hyprland/workspaces" 
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "tray",
	"network",
	"network#fuuka",
        "wireplumber",
        "battery"
    ],
    "tray": {
        "spacing": 10
    },
    "clock": {
        "tooltip-format": "{:%A %d %B %Y}",
        "interval": 1,
        "format": "{:%H:%M:%S}"
    },
    "custom/hostname": {
        "format": "{}",
        "tooltip": "Hello world!",
        "exec": "cat /etc/hostname"
    },
    "wireplumber": {
        "format": " vol : {volume}%",
        "format-muted": "vol : muted",
        "nospacing": 1,
        "scroll-step": 1
    },
    "network": {
        "format-wifi": "{essid}",
        "format-ethernet": "Wired",
        "format-disconnected": "No Wi-Fi",
        "format-disabled": "Airplane Mode",
        "tooltip-format": "Strength : {signalStrength}%\n{ipaddr}/{cidr}\n↑ {bandwidthUpOctets} | ↓ {bandwidthDownOctets}",
        "on-click": "nm-connection-editor"
    },
    "network#fuuka": {
        "interface": "fuuka0",
        "format-connected": "Fuuka",
        "format-disabled": "",
        "tooltip-format": "{ipaddr}/{cidr}\n↑ {bandwidthUpOctets} | ↓ {bandwidthDownOctets}"
    },
    "battery": {
        "format": "{capacity}%",
        "interval": 10,
        "states": {
            "warning": 30,
            "critical": 10
        },
        "tooltip": false
    }
}
